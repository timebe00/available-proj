<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>작업 항목 확인</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/sunn-us/SUIT/fonts/variable/woff2/SUIT-Variable.css" />

<script src="/common/vander/jquery.js"></script>
<script src="/common/vander/axios.js"></script>
<script src="/common/js/senderAxios.js"></script>

<style>
    :root {
        --bg-top: #f7faff;
        --bg-btm: #eef3ff;
        --card: #ffffff;
        --text: #191f28;
        --muted: #6b7684;
        --line: #e5e8eb;
        --primary: #3182f6;
        --primary-strong: #1b64da;
        --shadow: 0 24px 44px rgba(15, 23, 42, 0.12);
    }

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        min-height: 100%;
    }

    body {
        padding: 18px;
        background: radial-gradient(circle at 10% 0%, var(--bg-top) 0%, var(--bg-btm) 100%);
        color: var(--text);
        font-family: "SUIT Variable", "Noto Sans KR", sans-serif;
    }

    .popup-shell {
        width: min(720px, 100%);
        margin: 0 auto;
    }

    .popup-card {
        border: 1px solid var(--line);
        border-radius: 22px;
        background: var(--card);
        box-shadow: var(--shadow);
        padding: 20px;
    }

    .popup-head h1 {
        margin: 0;
        font-size: 26px;
        letter-spacing: -0.02em;
    }

    .popup-head p {
        margin: 8px 0 0;
        color: var(--muted);
        font-size: 14px;
    }

    .summary-grid {
        margin-top: 16px;
        display: grid;
        gap: 10px;
    }

    .summary-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border: 1px solid #edf1f6;
        border-radius: 14px;
        background: #fbfcff;
        padding: 12px 14px;
        gap: 10px;
    }

    .summary-item .label {
        color: #4e5968;
        font-size: 14px;
        font-weight: 600;
    }

    .summary-item .value {
        font-size: 21px;
        font-weight: 800;
        letter-spacing: -0.01em;
        font-variant-numeric: tabular-nums;
    }

    .summary-item.strong {
        border-color: #dce8ff;
        background: #eff5ff;
    }

    .summary-item.strong .value {
        color: var(--primary-strong);
    }

    .popup-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 14px;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 14px;
        border: none;
        border-radius: 12px;
        color: #ffffff;
        background: linear-gradient(180deg, #4390ff 0%, #3182f6 100%);
        box-shadow: 0 10px 20px rgba(49, 130, 246, 0.25);
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        letter-spacing: -0.01em;
        cursor: pointer;
    }

    .action-btn:hover {
        opacity: 0.94;
    }


    /* Typography scale-up */
    body {
        font-size: 16px;
        line-height: 1.5;
    }

    .popup-head h1 {
        font-size: 28px;
    }

    .popup-head p,
    .summary-item .label {
        font-size: 15px;
    }

    .summary-item .value {
        font-size: 23px;
    }

    .action-btn {
        min-height: 46px;
        padding: 0 16px;
        font-size: 15px;
    }
    @media (max-width: 680px) {
        body {
            padding: 10px;
        }

        .popup-card {
            padding: 14px;
            border-radius: 16px;
        }

        .summary-item .value {
            font-size: 18px;
        }
    }
</style>
