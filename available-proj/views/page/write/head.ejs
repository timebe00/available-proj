<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>신규 작업 작성</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/sunn-us/SUIT/fonts/variable/woff2/SUIT-Variable.css" />
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet" />
<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
<script src="https://cdn.jsdelivr.net/npm/quill-image-resize-module@3.0.0/image-resize.min.js"></script>

<script src="/common/vander/jquery.js"></script>
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
<link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/jquery-ui-timepicker-addon/1.6.3/jquery-ui-timepicker-addon.min.css" />

<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
<script
    src="https://cdnjs.cloudflare.com/ajax/libs/jquery-ui-timepicker-addon/1.6.3/jquery-ui-timepicker-addon.min.js"></script>

<script src="/common/vander/axios.js"></script>
<script src="/common/js/senderAxios.js"></script>
<script src="/common/js/common.js"></script>

<style>
    :root {
        --bg-top: #f6f9ff;
        --bg-mid: #f2f6ff;
        --bg-btm: #eef3ff;
        --card: #ffffff;
        --text: #191f28;
        --muted: #8b95a1;
        --line: #e5e8eb;
        --line-soft: #eef2f6;
        --primary: #3182f6;
        --primary-strong: #1b64da;
        --focus-ring: rgba(49, 130, 246, 0.18);
    }

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        min-height: 100%;
    }

    body {
        padding: 30px 16px;
        background: radial-gradient(circle at 10% 0%, var(--bg-top) 0%, var(--bg-mid) 45%, var(--bg-btm) 100%);
        color: var(--text);
        font-family: "SUIT Variable", "Noto Sans KR", sans-serif;
    }

    .page-shell {
        position: relative;
        width: min(960px, 100%);
        margin: 0 auto;
    }

    .page-shell::before,
    .page-shell::after {
        position: absolute;
        z-index: 0;
        border-radius: 999px;
        content: "";
    }

    .page-shell::before {
        top: -38px;
        left: -20px;
        width: 170px;
        height: 170px;
        background: radial-gradient(circle, rgba(49, 130, 246, 0.16), rgba(49, 130, 246, 0));
    }

    .page-shell::after {
        right: -40px;
        bottom: -36px;
        width: 220px;
        height: 220px;
        background: radial-gradient(circle, rgba(27, 100, 218, 0.12), rgba(27, 100, 218, 0));
    }

    .container {
        position: relative;
        z-index: 1;
        max-height: calc(100vh - 60px);
        overflow-y: auto;
        border: 1px solid var(--line);
        border-radius: 28px;
        background: var(--card);
        box-shadow: 0 30px 60px rgba(15, 23, 42, 0.08);
        padding: 32px;
    }

    .page-head {
        margin-bottom: 18px;
    }

    .page-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 12px;
        border-radius: 999px;
        background: #ecf3ff;
        color: #2f6fed;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-transform: uppercase;
    }

    h1 {
        margin: 12px 0 8px;
        font-size: clamp(26px, 4vw, 34px);
        line-height: 1.2;
        letter-spacing: -0.02em;
    }

    .page-head p {
        margin: 0;
        color: var(--muted);
        font-size: 15px;
    }

    .form-section {
        display: grid;
        gap: 14px;
    }

    .field-card {
        border: 1px solid var(--line-soft);
        border-radius: 18px;
        padding: 16px 18px 18px;
        background: linear-gradient(180deg, #fcfdff 0%, #f9fbff 100%);
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .field-card:focus-within {
        border-color: #d6e5ff;
        box-shadow: 0 0 0 4px var(--focus-ring);
    }

    label {
        display: block;
        margin-bottom: 8px;
        color: #4e5968;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.01em;
    }

    .date-group {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .deliverable-controls {
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        gap: 10px;
        align-items: end;
    }

    .checkbox-group {
        display: flex;
        align-items: center;
        gap: 8px;
        height: 44px;
        padding: 0 12px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: #ffffff;
        white-space: nowrap;
    }

    .checkbox-group label {
        margin: 0;
        color: #4e5968;
        font-size: 13px;
        font-weight: 600;
    }

    input[type="checkbox"] {
        width: 18px;
        height: 18px;
        margin: 0;
        accent-color: var(--primary);
        cursor: pointer;
    }

    .price-grid {
        display: grid;
        gap: 12px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    input[type="text"],
    select,
    textarea,
    .underline-input {
        width: 100%;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: #ffffff;
        padding: 11px 12px;
        color: var(--text);
        font-size: 15px;
        outline: none;
    }

    input[type="text"]:focus,
    select:focus,
    textarea:focus,
    .underline-input:focus {
        border-color: var(--primary-strong);
        box-shadow: 0 0 0 4px var(--focus-ring);
    }

    textarea {
        min-height: 130px;
        resize: vertical;
        line-height: 1.6;
    }

    .editor-shell {
        border: 1px solid var(--line);
        border-radius: 14px;
        background: #ffffff;
        overflow: hidden;
    }

    #editor {
        min-height: 360px;
        height: 420px;
        background: #ffffff;
    }

    .editor-shell .ql-toolbar.ql-snow {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        gap: 6px;
        padding: 8px 10px;
        border: none;
        border-bottom: 1px solid var(--line);
        border-radius: 0;
        background: #fbfcfe;
        overflow-x: auto;
        overflow-y: hidden;
        white-space: nowrap;
        -webkit-overflow-scrolling: touch;
    }

    .editor-shell .ql-toolbar.ql-snow .ql-formats {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin: 0 8px 0 0;
    }

    .editor-shell .ql-toolbar.ql-snow .ql-formats:last-child {
        margin-right: 0;
    }

    .editor-shell .ql-toolbar.ql-snow button {
        min-width: 0;
        width: 30px;
        height: 30px;
        margin: 0;
        padding: 4px;
        border-radius: 8px;
    }

    .editor-shell .ql-toolbar.ql-snow .ql-picker {
        height: 30px;
    }

    .editor-shell .ql-toolbar.ql-snow .ql-picker.ql-header {
        min-width: 88px;
    }

    .editor-shell #editor.ql-container.ql-snow {
        border: none;
        border-radius: 0;
        overflow: hidden;
    }

    .editor-shell #editor .ql-editor {
        min-height: 320px;
        font-size: 16px;
        line-height: 1.7;
        color: #191f28;
    }

    .editor-shell #editor .ql-editor p {
        margin: 0 0 0.65em;
    }

    .editor-shell #editor .ql-editor img {
        max-width: 100%;
        height: auto;
        border-radius: 10px;
    }

    input[type="number"] {
        display: none;
    }

    .button-group {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 2px;
    }

    .button-group > button {
        min-width: 136px;
        border: none;
        border-radius: 14px;
        padding: 12px 18px;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: -0.01em;
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
    }

    #submitBtn,
    #modifyBtn {
        color: #ffffff;
        background: linear-gradient(180deg, #4390ff 0%, #3182f6 100%);
        box-shadow: 0 12px 22px rgba(49, 130, 246, 0.3);
    }

    #goMenuBtn {
        color: #2f3742;
        background: #eef2f7;
    }

    .button-group > button:hover {
        opacity: 0.94;
        transform: translateY(-1px);
    }

    #ui-datepicker-div .ui-timepicker-div .ui_tpicker_time_label {
        display: none;
    }

    #ui-datepicker-div .ui-timepicker-div .ui_tpicker_time {
        display: none;
    }

    #ui-datepicker-div .ui-datepicker-buttonpane .ui-datepicker-current {
        display: none;
    }


    /* Typography scale-up */
    body {
        font-size: 16px;
        line-height: 1.5;
    }

    .page-badge {
        font-size: 13px;
    }

    .page-head p {
        font-size: 16px;
    }

    label,
    .checkbox-group label {
        font-size: 14px;
    }

    input[type="text"],
    select,
    textarea,
    .underline-input {
        font-size: 16px;
        padding: 12px 14px;
    }

    .ql-editor {
        font-size: 16px;
        line-height: 1.65;
    }

    .button-group > button {
        min-width: 148px;
        font-size: 16px;
    }
    @media (max-width: 840px) {
        body {
            padding: 14px 10px;
        }

        .container {
            max-height: calc(100vh - 28px);
            padding: 20px 14px;
            border-radius: 20px;
        }

        .date-group,
        .price-grid {
            grid-template-columns: 1fr;
        }

        .deliverable-controls {
            grid-template-columns: 1fr;
        }

        .checkbox-group {
            justify-content: space-between;
        }

        .button-group {
            flex-direction: column-reverse;
        }

        .button-group > button {
            width: 100%;
        }

        #editor {
            height: 320px;
        }
    }
</style>



