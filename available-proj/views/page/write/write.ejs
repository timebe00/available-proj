<%
    let modify = {};
    let b_time = "";
    let e_time = "";
    let content = "";

    if (data.modify) {
        modify = data.modify.order;

        if (modify.b_time) {
            b_time = new Date(modify.b_time).toISOString().slice(0, 16);
        }

        if (modify.e_time) {
            e_time = new Date(modify.e_time).toISOString().slice(0, 16);
        }

        content = modify.content;
    }
%>

<div class="page-shell">
    <div class="container">
        <div class="page-head">
            <span class="page-badge">available project</span>
            <h1><%=modify.order_idx ? '작업 수정' : '신규 작업 등록'%></h1>
            <p>일정, 산출물, 금액, 메모를 한 화면에서 빠르게 입력하세요.</p>
        </div>

        <div class="form-section">
            <section class="field-card">
                <label for="title">작업명</label>
                <input type="text" id="title" class="underline-input" name="title" value="<%=modify.title ? modify.title.replace(/&#39;/g, `'`) : ''%>" />
            </section>

            <section class="field-card">
                <div class="date-group">
                    <div>
                        <label for="b_time">Best</label>
                        <input type="text" id="b_time" class="underline-input" name="datatime" placeholder="날짜와 시간을 선택" value="<%=b_time%>" readonly />
                    </div>
                    <div>
                        <label for="e_time">At Least</label>
                        <input type="text" id="e_time" class="underline-input" name="datatime" placeholder="날짜와 시간을 선택" value="<%=e_time%>" readonly />
                    </div>
                </div>
            </section>

            <section class="field-card deliverable-group">
                <label for="output">산출물</label>
                <div class="deliverable-controls">
                    <input type="text" id="output" class="underline-input" name="output" style="display: none;" placeholder="산출물 입력"
                        value="<%=modify.output%>" />
                    <select id="output_type" name="output_type">
                        <option value="">선택하세요</option>
                        <% for(let outputIdx in data.outputs){ let output=data.outputs[outputIdx]; %>
                            <option value="<%=output.price%>" <%=modify.output==output.name ? 'selected' : '' %>>
                                <%=output.name%>
                            </option>
                        <% } %>
                    </select>
                    <div class="checkbox-group">
                        <label for="isImportant">상단 노출</label>
                        <input type="checkbox" class="underline-input" id="isImportant" name="isImportant" <%=modify.imp_yn=="Y" ? "checked" : "" %> />
                    </div>
                </div>
            </section>

            <%if(sender == "broker") {%>
            <div class="price-grid">
                <section class="field-card">
                    <label for="orderPriceFormatted">주문단가</label>
                    <input type="text" id="orderPriceFormatted" class="underline-input" placeholder="금액 입력" autocomplete="off"
                        value="<%=modify.order_price%>" />
                    <input type="number" id="price" name="price" class="underline-input" min="0" step="1000" />
                </section>
                <section class="field-card">
                    <label for="showPriceFormatted">작업단가</label>
                    <input type="text" id="showPriceFormatted" class="underline-input" placeholder="금액 입력" autocomplete="off"
                        value="<%=modify.work_price%>" />
                    <input type="number" id="show_price" name="show_price" class="underline-input" min="0" step="1000" />
                </section>
            </div>
            <%} else if(sender == "order") {%>
                <section class="field-card" style="display: none;">
                    <label for="orderPriceFormatted">가격</label>
                    <input type="text" id="orderPriceFormatted" class="underline-input" placeholder="금액 입력" autocomplete="off"
                        value="<%=modify.order_price%>" />
                    <input type="number" id="price" name="price" class="underline-input" min="0" step="1000" />
                </section>
            <%} else if(sender == "work") {%>
                <section class="field-card" style="<%=modify.show_yn == 'N' ? 'display:none;' : ''%>">
                    <label for="showPriceFormatted">가격</label>
                    <input type="text" id="showPriceFormatted" class="underline-input" placeholder="금액 입력" autocomplete="off"
                        value="<%=modify.work_price%>" />
                    <input type="number" id="price" name="price" class="underline-input" min="0" step="1000" />
                </section>
            <%}%>

            <section class="field-card">
                <label for="editor">작업 내용</label>
                <div class="editor-shell">
                    <div id="editor">
                        <%-decodeURIComponent(escape(atob(content || "" )))%>
                    </div>
                </div>
                <input type="hidden" id="taskContent" class="underline-input" name="taskContent" />
            </section>

            <section class="field-card">
                <label for="note">비고</label>
                <textarea id="note" name="note" placeholder="특이사항이나 메모"><%=decodeURIComponent(escape(atob(modify.note || "")))%></textarea>
            </section>

            <div class="button-group">
                <%if(modify.order_idx) {%>
                    <button type="button" id="modifyBtn">수정 완료</button>
                <%} else {%>
                    <button type="button" id="submitBtn">작성 완료</button>
                <%}%>
                <button type="button" id="goMenuBtn" onclick="location.href='<%=_props.CORES.sender[sender]%>'">
                    메뉴로 이동
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    const quill = new Quill('#editor', {
        theme: 'snow',
        placeholder: '작업 내용을 입력하세요..',
        modules: {
            toolbar: [
                [{ header: [1, 2, false] }],
                ['bold', 'italic', 'underline'],
                ['link', 'image'],
                [{ list: 'ordered' }, { list: 'bullet' }],
                [{ color: [] }, { background: [] }],
                ['clean']
            ],
            imageResize: {
                modules: ['Resize', 'DisplaySize']
            }
        }
    });

    function selectLocalImage() {
        const input = document.createElement('input');
        input.setAttribute('type', 'file');
        input.setAttribute('accept', 'image/*');
        input.click();

        input.onchange = async () => {
            const file = input.files[0];
            if (/^image\//.test(file.type)) {
                const formData = new FormData();
                formData.append('file', file);

                const res = await fetch('/upload/image', {
                    method: 'POST',
                    body: formData
                });

                const data = await res.json();
                const range = quill.getSelection() || { index: quill.getLength() };
                quill.insertEmbed(range.index, 'image', data.url);
            } else {
                alert('이미지 파일만 업로드 가능합니다.');
            }
        };
    }

    async function uploadImageToServer(file) {
        const formData = new FormData();
        formData.append('file', file);

        try {
            const res = await fetch('/upload/image', {
                method: 'POST',
                body: formData
            });

            const data = await res.json();
            const range = quill.getSelection(true) || { index: quill.getLength() };
            quill.insertEmbed(range.index, 'image', data.url);
            quill.setSelection(range.index + 1);
        } catch (err) {
            alert('이미지 업로드에 실패했습니다.');
            console.error(err);
        }
    }

    // 에디터 이미지 버튼 클릭 시 커스텀 핸들러 연결
    quill.getModule('toolbar').addHandler('image', selectLocalImage);

    quill.root.addEventListener('paste', function (e) {
        const clipboardData = e.clipboardData || window.clipboardData;
        if (clipboardData && clipboardData.items) {
            for (let i = 0; i < clipboardData.items.length; i++) {
                const item = clipboardData.items[i];
                if (item.type.indexOf('image') !== -1) {
                    const file = item.getAsFile();
                    uploadImageToServer(file);
                    e.preventDefault(); // blob 기본 삽입 막기
                }
            }
        }
    });

    quill.root.addEventListener('drop', function (e) {
        e.preventDefault();
        if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length) {
            const file = e.dataTransfer.files[0];
            if (file.type.startsWith('image/')) {
                uploadImageToServer(file);
            }
        }
    });

    const orderPriceFormatted = $('#orderPriceFormatted');
    const showPriceFormatted = $('#showPriceFormatted');

    let isModify = false;
    let isWrite = false;

    function formatPriceInput(price_input) {
        if (!price_input.length) {
            return;
        }
        const raw = String(price_input.val() || '').replace(/[^0-9]/g, '');
        if (!raw) {
            price_input.val('0');
            return;
        }
        price_input.val(Number(raw).toLocaleString('ko-KR'));
    }

    $(orderPriceFormatted).on('input', function () {
        formatPriceInput(orderPriceFormatted);
    });

    $(showPriceFormatted).on('input', function () {
        formatPriceInput(showPriceFormatted);
    });

    function getOrderPriceValue() {
        return orderPriceFormatted.length ? String(orderPriceFormatted.val() || '') : '';
    }

    function getShowPriceValue() {
        return showPriceFormatted.length ? String(showPriceFormatted.val() || '') : '';
    }

    $(document).ready(function () {
        $('#output_type').on('change', function () {
            if (!$(this).val()) {
                return
            }

            const selectedIndex = this.selectedIndex;
            if (selectedIndex === -1) {
                return null;
            }

            $('#output').val(this.options[selectedIndex].text);

            <%if( !(sender == "order" && modify.order_idx)) {%>
                if (orderPriceFormatted.length) {
                    orderPriceFormatted.val(Number(this.value).toLocaleString('ko-KR'));
                }
                if (showPriceFormatted.length) {
                    showPriceFormatted.val(Number(this.value).toLocaleString('ko-KR'));
                }
            <%}%>
        });

        $('#submitBtn').on('click', async () => {
            if (isWrite) return;
            isWrite = true;

            const title = $('#title').val();
            const b_time = $('#b_time').val() || null;
            const e_time = $('#e_time').val() || null;
            const output = $('#output').val();
            const order_price = getOrderPriceValue();
            const show_price = getShowPriceValue();
            const contentHtml = quill.root.innerHTML;
            const note = $('#note').val();
            const imp_yn = $('#isImportant').is(':checked') ? 'Y' : 'N';

            if (!title) {
                alert('작업명을 입력해주세요.');
                isWrite = false;
                return;
            }

            try {
                const contentData = await common.enc(contentHtml);
                const noteData = await common.enc(note);

                const params = {
                    title: common.scriptBtoA(title)
                    , b_time: b_time
                    , e_time: e_time
                    , output: output
                    , order_price: order_price
                    , show_price: show_price
                    , content: contentData
                    , note: noteData
                    , imp_yn: imp_yn
                };

                await senderAxios.callAxios('<%=_props.CORES.sender[sender]%>/setOrder', 'post', params)
                    .then(() => {
                        alert("저장되었습니다.")
                        location.href = "<%=_props.CORES.sender[sender]%>"
                    })
            } finally {
                isWrite = false;
            }
        });

        $('#modifyBtn').on('click', async () => {
            if (isModify) return;
            isModify = true;

            const title = $('#title').val();
            const b_time = $('#b_time').val() || null;
            const e_time = $('#e_time').val() || null;
            const output = $('#output').val();
            const order_price = getOrderPriceValue();
            const show_price = getShowPriceValue();
            const contentHtml = quill.root.innerHTML;
            const note = $('#note').val();
            const imp_yn = $('#isImportant').is(':checked') ? 'Y' : 'N';

            if (!title) {
                alert('작업명을 입력해주세요.');
                isModify = false;
                return;
            }

            try {
                const contentData = await common.enc(contentHtml);
                const noteData = await common.enc(note);

                const params = {
                    order_idx: '<%=modify.order_idx%>'
                    , title: common.scriptBtoA(title)
                    , b_time: b_time
                    , e_time: e_time
                    , output: output
                    , order_price: order_price
                    , show_price: show_price
                    , content: contentData
                    , note: noteData
                    , imp_yn: imp_yn
                };

                await senderAxios.callAxios('<%=_props.CORES.sender[sender]%>/modifyOrder', 'post', params)
                    .then(function (data) {
                        alert("저장되었습니다.")
                        location.href = "<%=_props.CORES.sender[sender]%>"
                    })
            } finally {
                isModify = false;
            }
        });

        $('#title').on('input', function () {
            if ($(this).val().length > 255) {
                alert('제목은 255자 이내로 설정해주세요.');
                $(this).val($(this).val().substring(0, 255));
            }
        });

        $.datepicker.setDefaults({
            closeText: '닫기',
            currentText: '오늘',
            prevText: '이전 달',
            nextText: '다음 달',
            monthNames: ['1월', '2월', '3월', '4월', '5월', '6월', '7월', '8월', '9월', '10월', '11월', '12월'],
            monthNamesShort: ['1월', '2월', '3월', '4월', '5월', '6월', '7월', '8월', '9월', '10월', '11월', '12월'],
            dayNames: ['일', '월', '화', '수', '목', '금', '토'],
            dayNamesShort: ['일', '월', '화', '수', '목', '금', '토'],
            dayNamesMin: ['일', '월', '화', '수', '목', '금', '토'],
            weekHeader: '주',
            yearSuffix: '년',
        });

        $('input[name="datatime"]').datetimepicker({
            dateFormat: 'yy-mm-dd',
            timeFormat: 'HH:00',
            controlType: 'select',
            stepMinute: 30,
            hourMin: 10,
            hourMax: 22,
            currentText: '현재 시간',
            closeText: '완료',
            timeOnlyTitle: '시간 선택',
            timeText: '시간',
            hourText: '시간',
            minuteText: '분',
            secondText: '초',
            amNames: ['오전', 'AM'],
            pmNames: ['오후', 'PM'],
            beforeShow: function () {
                setTimeout(filterOptions, 10);
            },
            onSelect: function () {
                setTimeout(filterOptions, 10);
            }
        });

        function filterOptions() {
            const dp = $('.ui-timepicker-div');
            if (!dp.length) return;

            dp.find('.ui_tpicker_hour select option').each(function () {
                const val = parseInt($(this).val(), 10);
                if (![10, 13, 17, 22].includes(val)) {
                    $(this).remove();
                }
            });
        }

        const now = new Date();
        now.setHours(13, 0, 0, 0);

        const rawBTime = '<%=modify.b_time || ""%>';
        const rawETime = '<%=modify.e_time || ""%>';

        if (rawBTime) {
            $('#b_time').datetimepicker('setDate', new Date(rawBTime));
        } else {
            $('#b_time').datetimepicker('setDate', now);
        }

        if (rawETime) {
            $('#e_time').datetimepicker('setDate', new Date(rawETime));
        } else {
            $('#e_time').datetimepicker('setDate', now);
        }
    });
</script>
